# ------------------------------------------------------------
# Only secrets / deployment-specific values belong here.
# Tenant structure and non-secret configuration live in YAML.
# ------------------------------------------------------------

# Optional management API protection
ADMIN_API_KEY=change-me-admin-key

# PeltierPro MCP bearer token
PELTIERPRO_MCP_ACCESS_TOKEN=change-me-peltier-mcp-token

# PeltierPro Odoo connection
PELTIERPRO_ODOO_URL=https://your-odoo.example.com
PELTIERPRO_ODOO_DATABASE=your_database
PELTIERPRO_ODOO_API_KEY=your_odoo_api_key

# Only needed if config/app.yaml gateway.authentication.mode = jwt
GATEWAY_JWT_ISSUER=
GATEWAY_JWT_AUDIENCE=
GATEWAY_JWT_JWKS_URL=
